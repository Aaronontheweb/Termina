# Shared header for every tape in this directory. Each tape begins with
#   Source screenshots/tapes/_common.tape
# and may then override Width/Height/TypingSpeed for its specific demo.
# capture.sh skips files prefixed with "_" so this isn't recorded itself.

Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 16
Set Padding 20
Set TypingSpeed 50ms
Set Width 1200
Set Height 700
